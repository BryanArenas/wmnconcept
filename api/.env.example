# Wind Mitigation Network — API environment (Appendix A).
# Copy to .env for local dev (loaded by dotenv-rails). Never commit real values.
# (public) marks values safe to expose to the browser/build.

# Database (local dev connects over the UNIX socket as the OS role; override for
# a URL-based connection or in production).
# DATABASE_URL=postgres://localhost/wmn_development
RAILS_MAX_THREADS=5

# Frontend / CORS / shared cookie.
FRONTEND_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set in production to the shared parent domain, e.g. .windmitigation.network
# SESSION_COOKIE_DOMAIN=

# OAuth (OmniAuth staff + agency).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Later milestones (kept here as the canonical env manifest) ---
# Payments (M7).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Transactional email (M6) + SMS reminders (M4).
POSTMARK_API_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Object storage for photos/reports (M5–M6).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=          # (public)
AWS_REGION=             # (public)
# Maps / geocoding.
GOOGLE_MAPS_API_KEY=
# Observability (M8).
SENTRY_DSN=
APP_HOST=               # (public)

# Local-only e2e auth shim (development only; see config/initializers/omniauth.rb).
# OMNIAUTH_TEST_MODE=1
# OMNIAUTH_TEST_EMAIL=coordinator@windmitigation.network
